GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=sqlite:///./invoice_risk.db

# GSTIN Registry API key from https://gstincheck.co.in (primary provider)
GSTINCHECK_API_KEY=your_gstincheck_api_key_here
# AppyFlow API key from https://appyflow.in (backup provider)
APPYFLOW_KEY_SECRET=your_appyflow_key_secret_here
# Max live GSTIN registry calls per session (circuit breaker)
GSTIN_REGISTRY_MAX_CALLS=50
